{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wotjr1649/codex-conductor-cc/evidence/schemas/toolchain-v1.schema.json",
  "title": "P3 exact Windows x64 toolchain",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "platform",
    "reviewPolicy",
    "tools",
    "actions",
    "specifications",
    "rejectedOrDeferred"
  ],
  "properties": {
    "$schema": { "const": "./evidence/schemas/toolchain-v1.schema.json" },
    "schemaVersion": { "const": "toolchain-v1" },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "architecture", "nodeRange"],
      "properties": {
        "os": { "const": "windows" },
        "architecture": { "const": "x64" },
        "nodeRange": { "const": ">=24.0.0" }
      }
    },
    "reviewPolicy": { "$ref": "#/$defs/reviewPolicy" },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/tool" }
    },
    "actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/action" }
    },
    "specifications": {
      "type": "array",
      "items": { "$ref": "#/$defs/specification" }
    },
    "rejectedOrDeferred": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "disposition"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "disposition": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "date": { "type": "string", "format": "date" },
    "reviewPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewedAt",
        "expiresAt",
        "owner",
        "reviewer",
        "driftTriggers"
      ],
      "properties": {
        "reviewedAt": { "$ref": "#/$defs/date" },
        "expiresAt": { "$ref": "#/$defs/date" },
        "owner": { "type": "string", "minLength": 1 },
        "reviewer": { "type": "string", "minLength": 1 },
        "driftTriggers": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "purpose",
        "owner",
        "installable",
        "artifact",
        "signature",
        "source",
        "review"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "purpose": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "installable": { "type": "boolean" },
        "artifact": { "$ref": "#/$defs/artifact" },
        "signature": { "$ref": "#/$defs/signature" },
        "source": { "$ref": "#/$defs/source" },
        "review": { "$ref": "#/$defs/review" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "url",
        "sha256",
        "executableRelativePath",
        "executableSha256",
        "installedExecutableName"
      ],
      "properties": {
        "kind": { "enum": ["file", "zip", "embedded"] },
        "url": { "type": "string", "pattern": "^https://" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "executableRelativePath": { "type": "string", "minLength": 1 },
        "executableSha256": { "$ref": "#/$defs/sha256" },
        "installedExecutableName": { "type": ["string", "null"] }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "published",
        "verified",
        "signer",
        "authenticodeRequired"
      ],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "published": { "type": "boolean" },
        "verified": { "type": "boolean" },
        "signer": { "type": ["string", "null"] },
        "authenticodeRequired": { "type": "boolean" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "releaseUrl",
        "tag",
        "commit",
        "releasedAt",
        "license",
        "licenseUrl"
      ],
      "properties": {
        "releaseUrl": { "type": "string", "pattern": "^https://" },
        "tag": { "type": "string", "minLength": 1 },
        "commit": { "$ref": "#/$defs/commit" },
        "releasedAt": { "$ref": "#/$defs/date" },
        "license": { "type": "string", "minLength": 1 },
        "licenseUrl": { "type": "string", "pattern": "^https://" }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewedAt", "expiresAt", "disposition"],
      "properties": {
        "reviewedAt": { "$ref": "#/$defs/date" },
        "expiresAt": { "$ref": "#/$defs/date" },
        "disposition": { "type": "string", "minLength": 1 }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "commit", "license", "disposition"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "commit": { "$ref": "#/$defs/commit" },
        "license": { "type": "string", "minLength": 1 },
        "disposition": { "type": "string", "minLength": 1 }
      }
    },
    "specification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "commit",
        "schemaUrl",
        "schemaSha256",
        "disposition"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "commit": { "$ref": "#/$defs/commit" },
        "schemaUrl": { "type": "string", "pattern": "^https://" },
        "schemaSha256": { "$ref": "#/$defs/sha256" },
        "disposition": { "type": "string", "minLength": 1 }
      }
    }
  }
}
