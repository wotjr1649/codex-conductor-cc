{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wotjr1649/codex-conductor-cc/evidence/schemas/p4-evidence-v1.schema.json",
  "title": "P4 Codex contract baseline evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "evidenceId",
    "phase",
    "source",
    "environment",
    "admissions",
    "snapshot",
    "localChecks",
    "immutableReadback",
    "privacy",
    "remoteExecution",
    "review",
    "attemptLedger"
  ],
  "properties": {
    "$schema": {
      "const": "../../schemas/p4-evidence-v1.schema.json"
    },
    "schemaVersion": {
      "const": "p4-evidence-v1"
    },
    "evidenceId": {
      "const": "p4-contract-baseline-20260731"
    },
    "phase": {
      "const": "P4"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseCommit", "contractCommit", "branch", "upstreamBase"],
      "properties": {
        "baseCommit": {
          "const": "34559b5a55fbc3b171e3f472080729795632b74f"
        },
        "contractCommit": {
          "$ref": "#/$defs/commit"
        },
        "branch": {
          "const": "codex/p4-contract-baseline"
        },
        "upstreamBase": {
          "const": "db52e28f4d9ded852ab3942cea316258ae4ef346"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "architecture",
        "node",
        "npm",
        "filesystem",
        "environmentClass",
        "privatePathsPersisted"
      ],
      "properties": {
        "os": { "const": "windows" },
        "architecture": { "const": "x64" },
        "node": { "const": "24.18.1" },
        "npm": { "const": "11.16.0" },
        "filesystem": { "const": "NTFS" },
        "environmentClass": {
          "const": "local-windows-x64-ntfs-run-owned"
        },
        "privatePathsPersisted": { "const": false }
      }
    },
    "admissions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lane",
          "version",
          "artifactId",
          "executableSha256",
          "status",
          "schemaExecution",
          "lifecycleExecution"
        ],
        "properties": {
          "lane": {
            "enum": ["build", "current", "previous"]
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "artifactId": {
            "type": "string",
            "minLength": 1
          },
          "executableSha256": {
            "$ref": "#/$defs/sha256"
          },
          "status": {
            "const": "accepted"
          },
          "schemaExecution": {
            "const": "executed-pass"
          },
          "lifecycleExecution": {
            "enum": ["executed-pass", "same-as-current"]
          }
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "treeSha256",
        "fileCount",
        "totalBytes",
        "independentRoots",
        "independentTreeSha256",
        "byteDiffExitCode",
        "normalization",
        "stableExperimentalSeparated"
      ],
      "properties": {
        "path": {
          "const": "contracts/codex/snapshots"
        },
        "treeSha256": {
          "$ref": "#/$defs/sha256"
        },
        "fileCount": {
          "type": "integer",
          "minimum": 1
        },
        "totalBytes": {
          "type": "integer",
          "minimum": 1
        },
        "independentRoots": {
          "const": 2
        },
        "independentTreeSha256": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/sha256"
          }
        },
        "byteDiffExitCode": {
          "const": 0
        },
        "normalization": {
          "const": "aggregate-json-object-key-order-only"
        },
        "stableExperimentalSeparated": {
          "const": true
        }
      }
    },
    "localChecks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "requirementIds",
          "fixtureIds",
          "trial",
          "retryCount",
          "timeout",
          "rawExitCode",
          "executionStatus",
          "behaviorStatus",
          "expected",
          "observed",
          "artifactSha256",
          "runtimeEnforced",
          "deferredPhase"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "requirementIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "fixtureIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "trial": {
            "const": 1
          },
          "retryCount": {
            "const": 0
          },
          "timeout": {
            "const": false
          },
          "rawExitCode": {
            "type": ["integer", "null"]
          },
          "executionStatus": {
            "$ref": "#/$defs/executionStatus"
          },
          "behaviorStatus": {
            "type": ["string", "null"],
            "enum": [
              "red",
              "already-green",
              "not-applicable",
              "blocked-with-evidence",
              null
            ]
          },
          "expected": {
            "type": "string",
            "minLength": 1
          },
          "observed": {
            "type": "string",
            "minLength": 1
          },
          "artifactSha256": {
            "type": ["string", "null"],
            "pattern": "^[0-9a-f]{64}$"
          },
          "runtimeEnforced": {
            "type": "boolean"
          },
          "deferredPhase": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "immutableReadback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protectedDigest",
        "generatedSchemaDigest",
        "generatedProtocolSha256",
        "toolchainSha256",
        "securityPolicySha256",
        "licenseSha256",
        "noticeSha256",
        "lockfileSha256",
        "status"
      ],
      "properties": {
        "protectedDigest": {
          "const": "b24fec394e331f6b550dfdb614be07ec19955c9f95288951afbcac4e4c8d0473"
        },
        "generatedSchemaDigest": {
          "const": "e504c5f04a3157a41a481bfc20cc77b8af58e4c750dcb47ad4453899779d4834"
        },
        "generatedProtocolSha256": {
          "const": "c4d141174754e04ef1cd1b904cd800d05e3174a772f86f0fc9c3f4d30ec3daf5"
        },
        "toolchainSha256": {
          "const": "a6033a05ebecd4ff5bca3a5924ff06e55a2e2de9b41541da2c050642102dbb5d"
        },
        "securityPolicySha256": {
          "const": "f4353ad5c207396f6c6c314aa522e16b556db81f2b0f18bb10741d5f4d8a9957"
        },
        "licenseSha256": {
          "const": "5382d9ba43803da42433ae0025fe38d93c6e730d8824bd9e01af8e2f3c9c3833"
        },
        "noticeSha256": {
          "const": "d8d0168f4940626032fe7a9d6e7a9b767b37f6c777a2140679e72e07afd1b8e0"
        },
        "lockfileSha256": {
          "const": "db1fb9ad6eb54eaabddc2f138c48435bd04feb04079b51c37838375e2b3e4f8b"
        },
        "status": {
          "const": "executed-pass"
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "privatePathsPersisted",
        "rawPayloadsPersisted",
        "rawPromptsPersisted",
        "secretsPersisted",
        "binaryArchivesPersisted",
        "redactionStatus"
      ],
      "properties": {
        "privatePathsPersisted": { "const": false },
        "rawPayloadsPersisted": { "const": false },
        "rawPromptsPersisted": { "const": false },
        "secretsPersisted": { "const": false },
        "binaryArchivesPersisted": { "const": false },
        "redactionStatus": { "const": "executed-pass" }
      }
    },
    "remoteExecution": {
      "const": "not-run"
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "findingCount", "disposition"],
      "properties": {
        "status": {
          "enum": ["not-run", "executed-pass"]
        },
        "findingCount": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "disposition": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "attemptLedger": {
      "const": "evidence/ledgers/p4-attempts.json"
    }
  },
  "$defs": {
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "executionStatus": {
      "enum": [
        "executed-pass",
        "executed-fail",
        "blocked-before-execution",
        "not-run"
      ]
    }
  }
}
