{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wotjr1649/codex-conductor-cc/evidence/schemas/p5-evidence-v2.schema.json",
  "title": "P5 matrix profile bootstrap and hosted observation evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "evidenceId",
    "phase",
    "overallStatus",
    "localBootstrapStatus",
    "hostedGateStatus",
    "source",
    "environment",
    "profileResults",
    "authenticatedClaude",
    "hostedRunner",
    "hostedObservation",
    "localChecks",
    "immutableReadback",
    "p4SourceBinding",
    "privacy",
    "remoteExecution",
    "review",
    "attemptLedger"
  ],
  "properties": {
    "$schema": {
      "const": "../../schemas/p5-evidence-v2.schema.json"
    },
    "schemaVersion": {
      "const": "p5-evidence-v2"
    },
    "evidenceId": {
      "const": "p5-matrix-profile-bootstrap-20260731"
    },
    "phase": {
      "const": "P5"
    },
    "overallStatus": {
      "enum": [
        "partial",
        "local-complete",
        "hosted-complete",
        "blocked"
      ]
    },
    "localBootstrapStatus": {
      "enum": [
        "executed-pass",
        "executed-fail",
        "blocked-with-evidence"
      ]
    },
    "hostedGateStatus": {
      "enum": [
        "not-run",
        "hosted-pass",
        "executed-fail",
        "blocked-with-evidence"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handoffCommit",
        "sourceCommit",
        "branch",
        "upstreamBase"
      ],
      "properties": {
        "handoffCommit": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "sourceCommit": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "branch": {
          "const": "codex/p5-matrix-profile-bootstrap"
        },
        "upstreamBase": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "architecture",
        "node",
        "npm",
        "filesystem",
        "environmentClass",
        "privatePathsPersisted"
      ],
      "properties": {
        "os": {
          "const": "windows"
        },
        "architecture": {
          "const": "x64"
        },
        "node": {
          "const": "24.18.1"
        },
        "npm": {
          "const": "11.16.0"
        },
        "filesystem": {
          "const": "NTFS"
        },
        "environmentClass": {
          "const": "local-windows-x64-ntfs-run-owned"
        },
        "privatePathsPersisted": {
          "const": false
        }
      }
    },
    "profileResults": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
        "$ref": "#/$defs/profileResult"
      }
    },
    "authenticatedClaude": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executionStatus",
        "authorized",
        "secretUsed",
        "paidInferenceUsed"
      ],
      "properties": {
        "executionStatus": {
          "const": "not-run"
        },
        "authorized": {
          "const": false
        },
        "secretUsed": {
          "const": false
        },
        "paidInferenceUsed": {
          "const": false
        }
      }
    },
    "hostedRunner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestedLabel",
        "imageVersion",
        "osBuild",
        "architecture",
        "filesystem",
        "executionStatus",
        "evidenceRole"
      ],
      "properties": {
        "requestedLabel": {
          "const": "windows-2025"
        },
        "imageVersion": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{8}\\.[0-9]+\\.[0-9]+$"
        },
        "osBuild": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]+$"
        },
        "architecture": {
          "enum": [
            null,
            "X64"
          ]
        },
        "filesystem": {
          "enum": [
            null,
            "NTFS"
          ]
        },
        "executionStatus": {
          "enum": [
            "not-run",
            "executed-fail",
            "hosted-pass"
          ]
        },
        "evidenceRole": {
          "enum": [
            "not-run",
            "terminal-gate-runner"
          ]
        }
      }
    },
    "localChecks": {
      "type": "array",
      "minItems": 20,
      "items": {
        "$ref": "#/$defs/localCheck"
      }
    },
    "immutableReadback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protectedDigest",
        "generatedProtocolSha256",
        "generatedSchemaDigest",
        "toolchainSha256",
        "securityPolicySha256",
        "p4SnapshotSha256",
        "p4ContractTree",
        "status"
      ],
      "properties": {
        "protectedDigest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "generatedProtocolSha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "generatedSchemaDigest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "toolchainSha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "securityPolicySha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "p4SnapshotSha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "p4ContractTree": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "status": {
          "const": "executed-pass"
        }
      }
    },
    "p4SourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recordedCommit",
        "actualCommit",
        "recordedCommitResolvable",
        "status",
        "p5CorrectionApplied"
      ],
      "properties": {
        "recordedCommit": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "actualCommit": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "recordedCommitResolvable": {
          "const": false
        },
        "status": {
          "const": "blocked-with-evidence"
        },
        "p5CorrectionApplied": {
          "const": false
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "privatePathsPersisted",
        "secretsPersisted",
        "rawEnvironmentPersisted",
        "rawPromptOrPayloadPersisted",
        "rawStdoutOrStderrPersisted",
        "binaryArchivesPersisted",
        "redactionStatus"
      ],
      "properties": {
        "privatePathsPersisted": {
          "const": false
        },
        "secretsPersisted": {
          "const": false
        },
        "rawEnvironmentPersisted": {
          "const": false
        },
        "rawPromptOrPayloadPersisted": {
          "const": false
        },
        "rawStdoutOrStderrPersisted": {
          "const": false
        },
        "binaryArchivesPersisted": {
          "const": false
        },
        "redactionStatus": {
          "const": "executed-pass"
        }
      }
    },
    "remoteExecution": {
      "enum": [
        "not-run",
        "executed-fail",
        "executed-pass"
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "findingCount",
        "acceptedCount",
        "rejectedCount",
        "deferredCount",
        "summary"
      ],
      "properties": {
        "status": {
          "const": "executed-pass"
        },
        "findingCount": {
          "minimum": 0,
          "type": "integer"
        },
        "acceptedCount": {
          "minimum": 0,
          "type": "integer"
        },
        "rejectedCount": {
          "minimum": 0,
          "type": "integer"
        },
        "deferredCount": {
          "minimum": 0,
          "type": "integer"
        },
        "summary": {
          "minLength": 1,
          "type": "string"
        }
      }
    },
    "attemptLedger": {
      "const": "evidence/ledgers/p5-attempts.json"
    },
    "hostedObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "pullRequestNumber",
        "runId",
        "runAttempt",
        "rerunCount",
        "event",
        "runUrl",
        "sourceHeadSha",
        "eventMergeSha",
        "workflowSha",
        "baseSha",
        "conclusion",
        "expectedLogicalJobCount",
        "observedRestJobCount",
        "placeholderJobCount",
        "collectionStatus",
        "collectionErrors",
        "validatedFragments",
        "artifacts",
        "cache"
      ],
      "properties": {
        "repository": {
          "const": "wotjr1649/codex-conductor-cc"
        },
        "pullRequestNumber": {
          "minimum": 1,
          "type": "integer"
        },
        "runId": {
          "minimum": 1,
          "type": "integer"
        },
        "runAttempt": {
          "minimum": 1,
          "type": "integer"
        },
        "rerunCount": {
          "minimum": 0,
          "type": "integer"
        },
        "event": {
          "const": "pull_request"
        },
        "runUrl": {
          "pattern": "^https://github\\.com/wotjr1649/codex-conductor-cc/actions/runs/[1-9][0-9]*$",
          "type": "string"
        },
        "sourceHeadSha": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "eventMergeSha": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "workflowSha": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "baseSha": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "conclusion": {
          "const": "failure"
        },
        "expectedLogicalJobCount": {
          "minimum": 1,
          "type": "integer"
        },
        "observedRestJobCount": {
          "minimum": 1,
          "type": "integer"
        },
        "placeholderJobCount": {
          "minimum": 0,
          "type": "integer"
        },
        "collectionStatus": {
          "const": "incomplete-or-invalid"
        },
        "collectionErrors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "minLength": 1,
            "type": "string"
          }
        },
        "validatedFragments": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/hostedFragment"
          }
        },
        "artifacts": {
          "$ref": "#/$defs/hostedTrustReadback"
        },
        "cache": {
          "$ref": "#/$defs/hostedTrustReadback"
        }
      }
    }
  },
  "$defs": {
    "profileResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profileId",
        "blocking",
        "localStatus",
        "hostedStatus",
        "disposition",
        "runtimeImplemented",
        "deferredPhase",
        "evidenceIds"
      ],
      "properties": {
        "profileId": {
          "minLength": 1,
          "type": "string"
        },
        "blocking": {
          "type": "boolean"
        },
        "localStatus": {
          "enum": [
            "defined",
            "local-pass",
            "hosted-pass",
            "non-blocking-canary",
            "not-run",
            "blocked-with-evidence",
            "not-applicable"
          ]
        },
        "hostedStatus": {
          "enum": [
            "defined",
            "local-pass",
            "hosted-pass",
            "non-blocking-canary",
            "not-run",
            "blocked-with-evidence",
            "not-applicable",
            "executed-fail",
            "skipped"
          ]
        },
        "disposition": {
          "minLength": 1,
          "type": "string"
        },
        "runtimeImplemented": {
          "type": "boolean"
        },
        "deferredPhase": {
          "enum": [
            null,
            "v0.2"
          ]
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "minLength": 1,
            "type": "string"
          }
        }
      }
    },
    "localCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "requirementIds",
        "fixtureIds",
        "trial",
        "retryCount",
        "timeout",
        "rawExitCode",
        "startedAt",
        "finishedAt",
        "wallTimeMs",
        "executionStatus",
        "expected",
        "observed",
        "artifactSha256",
        "runtimeEnforced",
        "deferredPhase"
      ],
      "properties": {
        "id": {
          "pattern": "^p5-[a-z0-9-]+$",
          "type": "string"
        },
        "requirementIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "minLength": 1,
            "type": "string"
          }
        },
        "fixtureIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "minLength": 1,
            "type": "string"
          }
        },
        "trial": {
          "minimum": 1,
          "type": "integer"
        },
        "retryCount": {
          "minimum": 0,
          "type": "integer"
        },
        "timeout": {
          "type": "boolean"
        },
        "rawExitCode": {
          "type": "integer"
        },
        "startedAt": {
          "format": "date-time",
          "type": "string"
        },
        "finishedAt": {
          "format": "date-time",
          "type": "string"
        },
        "wallTimeMs": {
          "minimum": 0,
          "type": "integer"
        },
        "executionStatus": {
          "enum": [
            "executed-pass",
            "executed-fail",
            "not-run",
            "blocked-with-evidence"
          ]
        },
        "expected": {
          "minLength": 1,
          "type": "string"
        },
        "observed": {
          "minLength": 1,
          "type": "string"
        },
        "artifactSha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": [
            "string",
            "null"
          ]
        },
        "runtimeEnforced": {
          "type": "boolean"
        },
        "deferredPhase": {
          "enum": [
            null,
            "v0.2",
            "P6"
          ]
        }
      }
    },
    "hostedFragment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jobName",
        "jobKey",
        "checkRunId",
        "conclusion",
        "markerSha256",
        "imageOS",
        "imageVersion",
        "osCaption",
        "osVersion",
        "osBuild",
        "architecture",
        "powershellVersion",
        "filesystem",
        "node",
        "npm",
        "nodeExecutableSha256",
        "startedAt",
        "finishedAt",
        "wallTimeMs"
      ],
      "properties": {
        "jobName": {
          "enum": [
            "Dependency review",
            "CI"
          ]
        },
        "jobKey": {
          "enum": [
            "dependency-review",
            "gate"
          ]
        },
        "checkRunId": {
          "minimum": 1,
          "type": "integer"
        },
        "conclusion": {
          "enum": [
            "success",
            "failure"
          ]
        },
        "markerSha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "imageOS": {
          "const": "win25-vs2026"
        },
        "imageVersion": {
          "pattern": "^[0-9]{8}\\.[0-9]+\\.[0-9]+$",
          "type": "string"
        },
        "osCaption": {
          "const": "Microsoft Windows Server 2025 Datacenter"
        },
        "osVersion": {
          "const": "10.0.26100"
        },
        "osBuild": {
          "const": "26100"
        },
        "architecture": {
          "const": "X64"
        },
        "powershellVersion": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "type": "string"
        },
        "filesystem": {
          "const": "NTFS"
        },
        "node": {
          "const": "24.18.1"
        },
        "npm": {
          "const": "11.16.0"
        },
        "nodeExecutableSha256": {
          "const": "ac51903c4c111815d52280b1fdcc8da067cbb37e2fe1a765097b85c3292c8582"
        },
        "startedAt": {
          "format": "date-time",
          "type": "string"
        },
        "finishedAt": {
          "format": "date-time",
          "type": "string"
        },
        "wallTimeMs": {
          "minimum": 0,
          "type": "integer"
        }
      }
    },
    "hostedTrustReadback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "readbackStatus",
        "observedCount",
        "releaseTrustInput"
      ],
      "properties": {
        "readbackStatus": {
          "const": "resolved"
        },
        "observedCount": {
          "minimum": 0,
          "type": "integer"
        },
        "releaseTrustInput": {
          "const": false
        }
      }
    }
  }
}
