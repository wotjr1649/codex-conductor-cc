  "guardCorpus": {
    "executionPolicy": "data-only-never-execute-in-p4",
    "directDeleteForms": [
      "Remove-Item recursive",
      "cmd rmdir recursive",
      "git clean destructive",
      "filesystem API recursive delete"
    ],
    "coverageGaps": [
      "renamed executable",
      "encoded command",
      "indirect child process",
      "alternate filesystem API",
      "same-user out-of-band process"
    ],
    "failureForms": [
      "spawn failure",
      "timeout",
      "nonzero-or-non-two exit",
      "invalid JSON",
      "missing event",
      "stream loss"
    ]
  },
  "snapshotCorpus": {
    "executionPolicy": "data-only-no-restore-in-p4",
    "requiredCandidates": [
      "tracked file",
      "untracked file",
      "symlink or reparse metadata",
      "Git index and worktree metadata"
    ],
    "exclusionsAndFaults": [
      "ignored path",
      "outside-root path",
      "special file",
      "oversize file",
      "read failure",
      "linked worktree",
      "submodule",
      "sparse checkout",
      "LFS pointer",
      "alternate data stream",
      "ACL/EFS/compression",
      "hardlink",
      "manifest tamper",
      "content tamper"
    ],
    "outOfScope": [
      "same-user dual tamper prevention",
      "production restore implementation"
    ]
  }
}
