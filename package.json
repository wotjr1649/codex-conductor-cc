{
  "name": "codex-conductor-cc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Codex Conductor delegates tasks and code reviews from Claude Code to Codex.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "os": [
    "win32"
  ],
  "cpu": [
    "x64"
  ],
  "scripts": {
    "bump-version": "node scripts/bump-version.mjs",
    "check-version": "node scripts/bump-version.mjs --check",
    "prebuild": "node scripts/generate-app-server-types.mjs",
    "build": "tsc -p tsconfig.app-server.json",
    "test": "node --test tests/*.test.mjs",
    "validate:p3": "node scripts/validate-p3.mjs"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typescript": "^6.0.2"
  }
}
